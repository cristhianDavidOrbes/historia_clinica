{
  "info": {
    "name": "Modulo de historias - integracion pendiente",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Solo rutas del modulo de historias. Requiere implementar SeguridadApi y AuditoriaApi. Configurar autorizacion segun el modulo de seguridad de los companeros. Los IDs se capturan al ejecutar en orden."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "pacienteId",
      "value": ""
    },
    {
      "key": "version",
      "value": ""
    },
    {
      "key": "accesoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Registrar paciente ficticio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/pacientes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Paciente ficticio\",\n  \"documento\": \"DEMO-{{$timestamp}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"pacienteId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Listar pacientes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/pacientes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Consultar paciente por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/pacientes/{{pacienteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Crear historia",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/historias/{{pacienteId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"antecedentes\": \"Dato ficticio de antecedentes\",\n  \"alergias\": \"Dato ficticio de alergias\",\n  \"medicamentos\": \"Dato ficticio de medicamentos\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"version\", pm.response.json().version);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Consultar como enfermeria",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/historias/{{pacienteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Actualizar historia con version",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/historias/{{pacienteId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"antecedentes\": \"Dato ficticio actualizado\",\n  \"alergias\": \"Dato ficticio de alergias\",\n  \"medicamentos\": \"Dato ficticio de medicamentos\",\n  \"versionEsperada\": {{version}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"version\", pm.response.json().version);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Consulta de urgencias con atencion",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/urgencias/pacientes/{{pacienteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Declarar emergencia sin asignacion",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/urgencias/pacientes/{{pacienteId}}/emergencias"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"accesoId\", pm.response.json().accesoId);"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Justificar emergencia",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/urgencias/emergencias/{{accesoId}}/justificacion",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"motivo\": \"Ejercicio ficticio de atencion de urgencias\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Listar emergencias pendientes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/urgencias/emergencias"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Revisar emergencia",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/urgencias/emergencias/{{accesoId}}/revision",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"comentario\": \"Ejercicio ficticio revisado\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}
